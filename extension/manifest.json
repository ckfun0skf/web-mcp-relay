{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "Web MCP Relay (Experimental)",
  "version": "0.8.2",
  "description": "Independent agent sessions for WebMCP pages, with scoped permissions and session management.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "multi-background.js", "type": "module" },
  "options_ui": { "page": "hint-options.html", "open_in_tab": true },
  "action": { "default_title": "Web MCP Relay", "default_popup": "popup.html" }
}
